# --- LedgerPilot (the demo target) ---
# OpenAI-compatible model endpoint (Hugging Face router / Groq / Ollama / etc.). The live console was measured
# on the setting below: every agent reply under 30 s. The key is a Hugging Face token (or set HF_TOKEN).
LEDGERPILOT_LLM_MODEL=openai/gpt-oss-120b:cerebras
LEDGERPILOT_LLM_BASE_URL=https://router.huggingface.co/v1
LEDGERPILOT_LLM_API_KEY=
# For reasoning models only: low | medium | high (unset = the provider's default).
# LEDGERPILOT_LLM_REASONING_EFFORT=
LEDGERPILOT_DATA_DIR=data
LEDGERPILOT_APPROVAL_THRESHOLD=10000

# --- Platform: its own models (attacker, explainer, codemod author) ---
# One shared key for all of them; each role's own variable below still wins. If unset, the platform falls back to
# LEDGERPILOT_LLM_API_KEY above, only so this demo keeps working with a single key.
# PURPLETEAM_LLM_API_KEY=

# --- Platform: live multi-turn attacker model ---
# The adversarial model must be one you are authorized to use for red-teaming. Hosted
# safety-tuned models refuse this role, so run a local model you control via Ollama:
#   ollama pull qwen2.5:3b-instruct
# PURPLETEAM_ATTACKER_ENDPOINT=http://localhost:11434/v1
# PURPLETEAM_ATTACKER_MODEL=qwen2.5:3b-instruct
# PURPLETEAM_ATTACKER_KEY=ollama
# The seed-corpus path (purpleteam.attack.corpus) needs no attacker model, and neither does the live console's
# default attack set (PURPLETEAM_ONLY_STATIC, on unless set to 0).
# How many unique prompts an adaptive (TAP/PAIR/...) attack may send a target. Operator-set only; default 5.
# PURPLETEAM_MAX_UNIQUE_PROMPTS=5
# Declared agent permissions (purpleteam.identity.PermissionManifest), a JSON file mapping each agent to the tools
# it may call. With it, a call outside those permissions is proof of privilege escalation and the P11 guard
# enforces exactly them; unset, identity is checked against what each agent holds today.
# PURPLETEAM_MANIFEST=.purpleteam/manifest.json

# How checkpoints are signed (purpleteam.audit.hardware_signer):
#   preferred (default) - use this machine's TPM if present, else carry on with software hybrid signatures only.
#   required            - refuse to run without a hardware TPM (the hardened build).
#   software            - sign the checkpoint with a real in-memory P-256 key, labelled "software" (never a TPM).
#                         Use this to host the live URL on a free box with no TPM: the signature is genuine and
#                         verifies; the page says plainly there is no hardware on this host. Keep the default on
#                         your own TPM-equipped machine for the in-person demo.
#   off                 - no checkpoint co-signature at all (the per-event Ed25519 + ML-DSA signatures still apply).
# PURPLETEAM_HARDWARE_SIGNING=software
