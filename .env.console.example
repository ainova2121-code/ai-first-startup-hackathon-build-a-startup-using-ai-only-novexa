# Copy to .env.console and fill in. This file holds a secret — it is gitignored; never commit it.

# --- Your domain, for Caddy's automatic TLS certificate (deploy/Caddyfile) ---
# Use "localhost" to try the console locally with a self-signed certificate.
CONSOLE_DOMAIN=console.example.com

# --- Required: encrypts every registered gateway's admin key at rest. Generate your own:
#       openssl rand -hex 32
CONSOLE_SECRET_KEY=

# --- How often the console polls each registered gateway for new signed events (seconds) ---
CONSOLE_POLL_SECONDS=15
